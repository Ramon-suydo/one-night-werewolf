# Copy to .env.local. Leave unset to use the local, single-server development store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: local store path, relative to project root. Never enable on Vercel.
# LOCAL_DATA_DIR=.local-data
